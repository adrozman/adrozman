---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% for post in site.posts %}
  <url>
    <loc>{{ site.url }}{{ post.url }}</loc>
  </url>
  {% endfor %}
  {% for page in site.pages %}
    {% if page.url contains '.html' or page.url contains '.pdf' or page.url == '/' or page.url contains '/blog/' or page.url contains '/publications/' or page.url contains '/research/' %}
    <url>
      <loc>{{ site.url }}{{ page.url }}</loc>
    </url>
    {% endif %}
  {% endfor %}
</urlset>
