---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  
  {% for post in site.posts %}
    {% if post.sitemap != false and post.sitemap != 'false' %}
    <url>
      <loc>{{ site.url }}{{ post.url }}</loc>
    </url>
    {% endif %}
  {% endfor %}
  
  {% for page in site.pages %}
    {% if page.sitemap != false and page.sitemap != 'false' %}
      {% if page.url contains '.html' or page.url contains '.pdf' or page.url == '/' or page.url contains '/blog/' or page.url contains '/publications/' or page.url contains '/research/' %}
        
        {% comment %} Ignore the 404 page and any auto-generated redirect HTML files {% endcomment %}
        {% unless page.url contains '404.html' or page.url contains '/2026/' %}
        <url>
          <loc>{{ site.url }}{{ page.url }}</loc>
        </url>
        {% endunless %}
        
      {% endif %}
    {% endif %}
  {% endfor %}

</urlset>
